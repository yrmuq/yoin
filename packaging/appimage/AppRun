# Entry point for the AppImage. The image is not a 1.0 release.
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
export YOIN_ASSETS="${YOIN_ASSETS:-$HERE/assets}"
export YOIN_LANGUAGES="${YOIN_LANGUAGES:-$HERE/languages}"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/yoin" "$@"
