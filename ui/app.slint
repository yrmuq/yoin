import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct Face {
    text: string,
    on: bool,
}

export struct Choice {
    index: int,
}

component PopupButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <color> button-bg;
    in property <color> button-fg;
    in property <color> accent;
    in property <color> on-fg;
    in property <color> border;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? accent : border;
    background: on ? accent : button-bg;
    Text {
        text: root.label;
        color: root.on ? root.on-fg : root.button-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 16px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Popup inherits Window {
    title: "yoin-buttons";
    no-frame: true;
    always-on-top: true;
    in-out property <[Face]> faces;
    in-out property <bool> dark: false;
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    callback pressed(int);
    width: 280px;
    height: 16px + max(1, faces.length) * 48px;
    background: transparent;
    property <color> bg: dark ? #1A1C22 : #F4F5F7;
    property <color> fg: dark ? #F2F4F7 : #1C1E22;
    property <color> button-bg: dark ? #2E333D : #E6E8ED;
    property <color> border: dark ? #3A3F4A : #D5D8DE;
    property <color> accent: dark ? #D7DEE8 : #2F3A4A;
    property <color> on-fg: dark ? #1A1C22 : #F4F6F8;
    Rectangle {
        background: bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.border;
        VerticalBox {
            padding: 8px;
            spacing: 8px;
            for face[i] in faces: PopupButton {
                label: face.text;
                on: face.on;
                button-bg: root.button-bg;
                button-fg: root.fg;
                accent: root.accent;
                on-fg: root.on-fg;
                border: root.border;
                clicked => { root.pressed(i); }
            }
        }
    }
}

export component Settings inherits Window {
    title: "yoin";
    in-out property <bool> dark: false;
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    in-out property <string> address;
    in-out property <string> token;
    in-out property <string> device;
    in-out property <bool> autostart;
    in-out property <string> status;
    in-out property <string> version;
    in-out property <[string]> entity-names;
    in-out property <[Choice]> rows;
    in-out property <int> language-index;
    in-out property <int> theme-index;
    in-out property <[string]> language-names;
    in-out property <[string]> theme-names;
    in-out property <string> t-connection;
    in-out property <string> t-buttons;
    in-out property <string> t-appearance;
    in-out property <string> t-address;
    in-out property <string> t-token;
    in-out property <string> t-token-hint;
    in-out property <string> t-device;
    in-out property <string> t-device-hint;
    in-out property <string> t-autostart;
    in-out property <string> t-connect;
    in-out property <string> t-save;
    in-out property <string> t-language;
    in-out property <string> t-theme;
    callback connect();
    callback save();
    callback add();
    callback up(int);
    callback down(int);
    callback remove(int);
    callback pick(int, int);
    callback language(int);
    callback theme(int);
    preferred-width: 560px;
    preferred-height: 640px;
    background: dark ? #1A1C22 : #F4F5F7;
    VerticalBox {
        padding: 12px;
        spacing: 8px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: root.t-connection;
                VerticalBox {
                    alignment: start;
                    padding: 8px;
                    Text { text: root.t-address; }
                    addr := LineEdit {
                        text <=> root.address;
                        placeholder-text: "http://homeassistant.local:8123";
                    }
                    Text { text: root.t-token; }
                    LineEdit {
                        text <=> root.token;
                        placeholder-text: root.t-token-hint;
                        input-type: password;
                    }
                    Text { text: root.t-device; }
                    LineEdit { text <=> root.device; }
                    Text {
                        text: root.t-device-hint;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                    CheckBox {
                        text: root.t-autostart;
                        checked <=> root.autostart;
                    }
                    HorizontalBox {
                        Button { text: root.t-connect; clicked => { root.connect(); } }
                        Button { text: root.t-save; clicked => { root.save(); } }
                    }
                    Text { text: root.status; wrap: word-wrap; }
                }
            }
            Tab {
                title: root.t-buttons;
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        padding: 8px;
                        spacing: 6px;
                        for row[i] in rows: HorizontalBox {
                            combo := ComboBox {
                                model: root.entity-names;
                                current-index: row.index;
                                selected => { root.pick(i, combo.current-index); }
                            }
                            Button { text: "↑"; clicked => { root.up(i); } }
                            Button { text: "↓"; clicked => { root.down(i); } }
                            Button { text: "−"; clicked => { root.remove(i); } }
                        }
                        if rows.length < 10: Button {
                            text: "+";
                            clicked => { root.add(); }
                        }
                    }
                }
            }
            Tab {
                title: root.t-appearance;
                VerticalBox {
                    alignment: start;
                    padding: 8px;
                    Text { text: root.t-language; }
                    lang := ComboBox {
                        model: root.language-names;
                        current-index: root.language-index;
                        selected => { root.language(lang.current-index); }
                    }
                    Text { text: root.t-theme; }
                    theme := ComboBox {
                        model: root.theme-names;
                        current-index: root.theme-index;
                        selected => { root.theme(theme.current-index); }
                    }
                }
            }
        }
        Text {
            text: root.version;
            horizontal-alignment: right;
            font-size: 12px;
        }
    }
}
