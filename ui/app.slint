import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct Face {
    text: string,
    on: bool,
}

export struct Choice {
    index: int,
}

// Breeze Light / Breeze Dark from KDE Plasma 6. Corner radius is 5px.
export global Breeze {
    in-out property <bool> dark: false;
    out property <color> window: dark ? #202326 : #eff0f1;
    out property <color> button: dark ? #292c30 : #fcfcfc;
    out property <color> button-hover: dark ? #32363b : #f3f4f5;
    out property <color> fg: dark ? #fcfcfc : #232629;
    out property <color> inactive: dark ? #a1a9b1 : #707d8a;
    out property <color> selection: #3daee9;
    out property <color> selection-fg: dark ? #fcfcfc : #ffffff;
    out property <color> frame: dark ? #4c4e51 : #c6c8c9;
    out property <length> radius: 5px;
}

component Label inherits Text {
    color: Breeze.fg;
}

component Hint inherits Text {
    color: Breeze.inactive;
    wrap: word-wrap;
}

component PopupButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    height: 36px;
    border-radius: Breeze.radius;
    border-width: 1px;
    property <bool> hovered: touch.has-hover;
    border-color: on || hovered ? Breeze.selection : Breeze.frame;
    background: on ? Breeze.selection : (hovered ? Breeze.button-hover : Breeze.button);
    Label {
        text: root.label;
        color: root.on ? Breeze.selection-fg : Breeze.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 16px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Popup inherits Window {
    title: "yoin-buttons";
    no-frame: true;
    always-on-top: true;
    in-out property <[Face]> faces;
    in-out property <bool> dark: false;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => {
        Breeze.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    callback pressed(int);
    width: 280px;
    height: 10px + max(1, faces.length) * 42px;
    background: transparent;
    Rectangle {
        background: Breeze.window;
        border-radius: Breeze.radius;
        border-width: 1px;
        border-color: Breeze.frame;
        clip: true;
        VerticalBox {
            padding: 8px;
            spacing: 6px;
            for face[i] in faces: PopupButton {
                label: face.text;
                on: face.on;
                clicked => { root.pressed(i); }
            }
        }
    }
}

export component Settings inherits Window {
    title: "yoin";
    in-out property <bool> dark: false;
    in-out property <string> ui-font-family: "Noto Sans";
    in-out property <length> ui-font-size: 13.333px;
    in-out property <int> ui-font-weight: 400;
    default-font-family: ui-font-family;
    default-font-size: ui-font-size;
    default-font-weight: ui-font-weight;
    changed dark => {
        Breeze.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    in-out property <string> address;
    in-out property <string> token;
    in-out property <string> device;
    in-out property <bool> autostart;
    in-out property <string> status;
    in-out property <string> version;
    in-out property <[string]> entity-names;
    in-out property <[Choice]> rows;
    in-out property <int> language-index;
    in-out property <int> theme-index;
    in-out property <[string]> language-names;
    in-out property <[string]> theme-names;
    in-out property <string> t-connection;
    in-out property <string> t-buttons;
    in-out property <string> t-appearance;
    in-out property <string> t-address;
    in-out property <string> t-token;
    in-out property <string> t-token-hint;
    in-out property <string> t-device;
    in-out property <string> t-device-hint;
    in-out property <string> t-autostart;
    in-out property <string> t-connect;
    in-out property <string> t-save;
    in-out property <string> t-language;
    in-out property <string> t-theme;
    callback connect();
    callback save();
    callback add();
    callback up(int);
    callback down(int);
    callback remove(int);
    callback pick(int, int);
    callback language(int);
    callback theme(int);
    preferred-width: 560px;
    preferred-height: 640px;
    background: Breeze.window;
    VerticalBox {
        padding: 12px;
        spacing: 8px;
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: root.t-connection;
                VerticalBox {
                    alignment: start;
                    padding: 8px;
                    Label { text: root.t-address; }
                    addr := LineEdit {
                        text <=> root.address;
                        placeholder-text: "http://homeassistant.local:8123";
                    }
                    Label { text: root.t-token; }
                    LineEdit {
                        text <=> root.token;
                        placeholder-text: root.t-token-hint;
                        input-type: password;
                    }
                    Label { text: root.t-device; }
                    LineEdit { text <=> root.device; }
                    Hint { text: root.t-device-hint; }
                    CheckBox {
                        text: root.t-autostart;
                        checked <=> root.autostart;
                    }
                    HorizontalBox {
                        Button { text: root.t-connect; clicked => { root.connect(); } }
                        Button { text: root.t-save; clicked => { root.save(); } }
                    }
                    Hint { text: root.status; }
                }
            }
            Tab {
                title: root.t-buttons;
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        padding: 8px;
                        spacing: 6px;
                        for row[i] in rows: HorizontalBox {
                            combo := ComboBox {
                                model: root.entity-names;
                                current-index: row.index;
                                selected => { root.pick(i, combo.current-index); }
                            }
                            Button { text: "↑"; clicked => { root.up(i); } }
                            Button { text: "↓"; clicked => { root.down(i); } }
                            Button { text: "−"; clicked => { root.remove(i); } }
                        }
                        if rows.length < 10: Button {
                            text: "+";
                            clicked => { root.add(); }
                        }
                    }
                }
            }
            Tab {
                title: root.t-appearance;
                VerticalBox {
                    alignment: start;
                    padding: 8px;
                    Label { text: root.t-language; }
                    lang := ComboBox {
                        model: root.language-names;
                        current-index: root.language-index;
                        selected => { root.language(lang.current-index); }
                    }
                    Label { text: root.t-theme; }
                    theme := ComboBox {
                        model: root.theme-names;
                        current-index: root.theme-index;
                        selected => { root.theme(theme.current-index); }
                    }
                }
            }
        }
        Hint {
            text: root.version;
            horizontal-alignment: right;
        }
    }
}
